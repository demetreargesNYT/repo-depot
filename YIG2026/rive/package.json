{
  "name": "yig-rive",
  "private": true,
  "description": "Year in Games 2026 Rive work. Scripts take a chapter folder name, e.g. ch2.",
  "scripts": {
    "check": "python3 tools/check.py",
    "rules": "python3 tools/check_chapter.py",
    "tap": "python3 tools/tap_test.py",
    "text": "node harness/text-test.mjs",
    "back": "python3 tools/back_test.py",
    "scaffold": "python3 tools/scaffold_chapter.py",
    "experience": "node harness/experience-test.mjs",
    "suite": "caffeinate -i python3 tools/suite.py",
    "smoke": "caffeinate -i python3 tools/suite.py --smoke",
    "finesse": "python3 tools/finesse.py",
    "open-package": "test -d .cache/scratch.nosync/shared/yig-engineering-package || python3 tools/package_engineering.py && open .cache/scratch.nosync/shared/yig-engineering-package"
  }
}
